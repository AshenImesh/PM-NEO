{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd pmneo/client && npm install && npm run build",
  "outputDirectory": "pmneo/client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
